UPDATE StudentEnrollments 
SET enrollment_date = '2024-07-04' 
WHERE student_id = 1;

--part b
-- User A (Reader)
START TRANSACTION;
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;

SELECT * FROM StudentEnrollments WHERE student_id = 1;
-- sees enrollment_date = '2024-06-01'

-- User B (Writer)
START TRANSACTION;

UPDATE StudentEnrollments 
SET enrollment_date = '2024-07-10' 
WHERE student_id = 1;

COMMIT;
SELECT * FROM StudentEnrollments WHERE student_id = 1;
-- still sees enrollment_date = '2024-06-01'
COMMIT;

START TRANSACTION;
SELECT * FROM StudentEnrollments 
WHERE student_id = 1 FOR UPDATE;
-- locks the row

START TRANSACTION;
UPDATE StudentEnrollments 
SET enrollment_date = '2024-07-20'
WHERE student_id = 1;
-- blocked until User A commits

START TRANSACTION;
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;

SELECT * FROM StudentEnrollments WHERE student_id = 1;
-- sees enrollment_date = '2024-06-01'
START TRANSACTION;
UPDATE StudentEnrollments 
SET enrollment_date = '2024-07-20'
WHERE student_id = 1;
COMMIT;
SELECT * FROM StudentEnrollments WHERE student_id = 1;
-- still sees enrollment_date = '2024-06-01'
COMMIT;
